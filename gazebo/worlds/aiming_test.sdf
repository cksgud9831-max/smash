<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="aiming_test">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- [1. 실감형 파란 하늘 스카이박스 및 대기 환경] -->
    <scene>
      <ambient>0.6 0.65 0.75 1.0</ambient>
      <background>0.5 0.68 0.88 1.0</background>
      <shadows>true</shadows>
      <sky>
        <time>12.0</time>
        <sunrise>6.0</sunrise>
        <sunset>18.0</sunset>
        <clouds>
          <speed>10.0</speed>
          <humidity>0.4</humidity>
          <mean_size>0.6</mean_size>
        </clouds>
      </sky>
    </scene>

    <!-- [2. 실시간 태양광 조명] -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.95 0.95 0.90 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- [3. 500m 대형 실감 사격 훈련장 대지] -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
          <material>
            <ambient>0.26 0.35 0.22 1</ambient>
            <diffuse>0.28 0.38 0.24 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- [4. 원거리 산악 지형 랜드스케이프] -->
    <model name="mountain_ridge_north">
      <static>true</static>
      <pose>120 0 15 0 0 0</pose>
      <link name="link">
        <visual name="ridge1">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>25 180 30</size></box></geometry>
          <material>
            <ambient>0.35 0.38 0.30 1</ambient>
            <diffuse>0.40 0.44 0.35 1</diffuse>
          </material>
        </visual>
        <visual name="ridge2">
          <pose>20 40 10 0 0 0.3</pose>
          <geometry><box><size>30 160 40</size></box></geometry>
          <material>
            <ambient>0.32 0.35 0.28 1</ambient>
            <diffuse>0.38 0.42 0.33 1</diffuse>
          </material>
        </visual>
        <visual name="ridge3">
          <pose>25 -50 8 0 0 -0.25</pose>
          <geometry><box><size>28 150 36</size></box></geometry>
          <material>
            <ambient>0.30 0.33 0.26 1</ambient>
            <diffuse>0.36 0.40 0.31 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- [5. 정밀 스마트 스코프 거치 소총 사격대 (Rifle & SMASH Smart Scope Platform)] -->
    <model name="platform">
      <static>false</static>
      <pose>0 0 1.2 0 0 0</pose>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial>
          <mass>3.5</mass>
          <inertia>
            <ixx>0.05</ixx><iyy>0.05</iyy><izz>0.05</izz>
          </inertia>
        </inertial>

        <!-- (1) 전술 삼각대 다리 3개 (Tactical Tripod Legs) -->
        <visual name="tripod_center">
          <pose>0 0 -0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <visual name="tripod_leg1">
          <pose>-0.25 0.25 -0.75 0.4 0.4 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.85</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <visual name="tripod_leg2">
          <pose>-0.25 -0.25 -0.75 -0.4 0.4 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.85</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <visual name="tripod_leg3">
          <pose>0.35 0 -0.75 0 -0.45 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.85</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>

        <!-- (2) 소총 리시버/몸통 (Rifle Main Receiver) -->
        <visual name="rifle_body">
          <pose>0.15 0 0.05 0 0 0</pose>
          <geometry><box><size>0.65 0.08 0.14</size></box></geometry>
          <material><ambient>0.12 0.13 0.15 1</ambient><diffuse>0.18 0.20 0.22 1</diffuse></material>
        </visual>

        <!-- (3) 소총 개머리판 (Rifle Stock) -->
        <visual name="rifle_stock">
          <pose>-0.32 0 0.03 0 0.1 0</pose>
          <geometry><box><size>0.32 0.06 0.16</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>

        <!-- (4) 소총 권총손잡이 (Pistol Grip) -->
        <visual name="rifle_grip">
          <pose>-0.05 0 -0.12 0 0.35 0</pose>
          <geometry><box><size>0.07 0.05 0.18</size></box></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>

        <!-- (5) 소총 30발 곡선 탄창 (30-round Magazine) -->
        <visual name="rifle_mag">
          <pose>0.18 0 -0.16 0 0.25 0</pose>
          <geometry><box><size>0.09 0.04 0.24</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>

        <!-- (6) 소총 롱 총열 및 총구 소염기 (Barrel & Flash Hider) -->
        <visual name="rifle_barrel">
          <pose>0.65 0 0.06 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.48</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.1 1</ambient><diffuse>0.12 0.12 0.15 1</diffuse></material>
        </visual>
        <visual name="flash_hider">
          <pose>0.90 0 0.06 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.028</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>

        <!-- (7) 상단 장착 [SMASH 지능형 스마트 스코프] 광학 하우징 본체 -->
        <visual name="smart_scope_mount">
          <pose>0.20 0 0.16 0 0 0</pose>
          <geometry><box><size>0.28 0.06 0.06</size></box></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
        <visual name="smart_scope_body">
          <pose>0.22 0 0.24 0 0 0</pose>
          <geometry><box><size>0.34 0.12 0.12</size></box></geometry>
          <material><ambient>0.18 0.22 0.26 1</ambient><diffuse>0.25 0.30 0.36 1</diffuse></material>
        </visual>
        <visual name="smart_scope_hood">
          <pose>0.41 0 0.24 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.055</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>

        <!-- 센서 디바이스 -->
        <sensor name="imu_sensor" type="imu">
          <always_on>1</always_on>
          <update_rate>50</update_rate>
          <topic>platform/imu</topic>
        </sensor>
        <sensor name="camera" type="camera">
          <pose>0.45 0 0.24 0 0 0</pose>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>0.85</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>1000</far>
            </clip>
          </camera>
          <topic>platform/camera/image</topic>
        </sensor>
        <sensor name="laser" type="gpu_lidar">
          <pose>0.45 0 0.28 0 0 0</pose>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <lidar>
            <scan>
              <horizontal>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.1</min>
              <max>500.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
          <topic>platform/laser/scan</topic>
        </sensor>
      </link>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <static_publisher>true</static_publisher>
        <static_update_frequency>50</static_update_frequency>
      </plugin>
    </model>

    <!-- 대형 3D 타겟 쿼드콥터 드론 (전방 35m 상공 정지 호버링) -->
    <model name="target">
      <static>false</static>
      <pose>35 0 3.5 0 0 0</pose>
      <link name="body">
        <gravity>false</gravity>
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz>
          </inertia>
        </inertial>
        <!-- 중앙 블랙 카본 바디 -->
        <visual name="core_visual">
          <geometry><box><size>0.9 0.9 0.22</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.15 1</ambient>
            <diffuse>0.1 0.1 0.15 1</diffuse>
          </material>
        </visual>
        <!-- 4개 로터 암 (폭 2.2m) -->
        <visual name="arm_cross1">
          <pose>0 0 0 0 0 0.785</pose>
          <geometry><box><size>2.2 0.14 0.08</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="arm_cross2">
          <pose>0 0 0 0 0 -0.785</pose>
          <geometry><box><size>2.2 0.14 0.08</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <!-- 형광 오렌지 전방 로터 2개 -->
        <visual name="rotor1">
          <pose>0.75 0.75 0.1 0 0 0</pose>
          <geometry><cylinder><radius>0.42</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>1.0 0.3 0.0 1</ambient><diffuse>1.0 0.3 0.0 1</diffuse></material>
        </visual>
        <visual name="rotor2">
          <pose>-0.75 0.75 0.1 0 0 0</pose>
          <geometry><cylinder><radius>0.42</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>1.0 0.3 0.0 1</ambient><diffuse>1.0 0.3 0.0 1</diffuse></material>
        </visual>
        <!-- 형광 블루 후방 로터 2개 -->
        <visual name="rotor3">
          <pose>0.75 -0.75 0.1 0 0 0</pose>
          <geometry><cylinder><radius>0.42</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.0 0.45 1.0 1</ambient><diffuse>0.0 0.45 1.0 1</diffuse></material>
        </visual>
        <visual name="rotor4">
          <pose>-0.75 -0.75 0.1 0 0 0</pose>
          <geometry><cylinder><radius>0.42</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.0 0.45 1.0 1</ambient><diffuse>0.0 0.45 1.0 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <static_publisher>true</static_publisher>
        <static_update_frequency>50</static_update_frequency>
      </plugin>
    </model>
  </world>
</sdf>
