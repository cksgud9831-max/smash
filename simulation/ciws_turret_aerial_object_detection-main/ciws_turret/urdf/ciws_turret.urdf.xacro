<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ciws_turret">

  <xacro:property name="mesh" value="package://ciws_turret/meshes"/>
  <xacro:property name="base_top" value="0.0885"/>
  <xacro:property name="PI" value="3.14159265359"/>
  <!-- trunnion (elevation pivot) in the turret(pan) frame -->
  <xacro:property name="piv_x" value="-0.024"/>
  <xacro:property name="piv_z" value="0.4565"/>

  <material name="tan"><color rgba="0.80 0.72 0.52 1.0"/></material>
  <material name="lgrey"><color rgba="0.75 0.75 0.77 1.0"/></material>
  <material name="mgrey"><color rgba="0.55 0.55 0.58 1.0"/></material>
  <material name="white"><color rgba="0.93 0.93 0.92 1.0"/></material>
  <material name="black"><color rgba="0.12 0.12 0.14 1.0"/></material>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial><mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12.0}" iyz="0" izz="${m*(x*x+y*y)/12.0}"/></inertial>
  </xacro:macro>

  <!-- ===================== BASE ===================== -->
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0"/></joint>
  <link name="base_link">
    <visual><geometry><mesh filename="${mesh}/base.stl"/></geometry><material name="tan"/></visual>
    <collision><origin xyz="0 0 ${base_top/2}"/><geometry><box size="0.72 0.75 ${base_top}"/></geometry></collision>
    <inertial><origin xyz="0 0 ${base_top/2}"/><mass value="6.0"/>
      <inertia ixx="0.30" ixy="0" ixz="0" iyy="0.30" iyz="0" izz="0.55"/></inertial>
  </link>

  <!-- ===================== TURRET: PAN (azimuth, continuous) ===================== -->
  <joint name="turret_pan_joint" type="continuous">
    <parent link="base_link"/><child link="turret_link"/>
    <origin xyz="0 0 ${base_top}"/><axis xyz="0 0 1"/>
    <limit effort="40.0" velocity="3.0"/><dynamics damping="0.3" friction="0.1"/>
  </joint>
  <link name="turret_link">
    <visual><geometry><mesh filename="${mesh}/turret.stl"/></geometry><material name="lgrey"/></visual>
    <collision><origin xyz="0 0 0.27"/><geometry><cylinder radius="0.28" length="0.52"/></geometry></collision>
    <inertial><origin xyz="0 0 0.22"/><mass value="4.0"/>
      <inertia ixx="0.22" ixy="0" ixz="0" iyy="0.22" iyz="0" izz="0.18"/></inertial>
  </link>

  <!-- ===================== ELEVATION ASSEMBLY (tilts about trunnion Y) ===================== -->
  <!-- The gun link carries the elevation joint; radome, rod, camera are fixed to it. -->
  <joint name="turret_tilt_joint" type="revolute">
    <parent link="turret_link"/><child link="gun_link"/>
    <origin xyz="${piv_x - 0.03785} 0 ${piv_z + 0.05}"/><axis xyz="0 -1 0"/>
    <limit lower="${0.0*PI/180.0}" upper="${85.0*PI/180.0}" effort="25.0" velocity="2.5"/>
    <dynamics damping="0.4" friction="0.1"/>
  </joint>
  <link name="gun_link">
    <visual><geometry><mesh filename="${mesh}/gun.stl"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0.293 0 -0.042"/><geometry><box size="0.876 0.358 0.234"/></geometry></collision>
    <xacro:box_inertia m="3.0" x="0.876" y="0.358" z="0.234"/>
  </link>

  <!-- radar dome (big white cylinder) -->
  <joint name="radome_joint" type="fixed"><parent link="gun_link"/><child link="radome_link"/>
    <origin xyz="0 0.25 0.4575" rpy="${PI/2} -${PI/2} 0"/></joint>
  <link name="radome_link">
    <visual><geometry><mesh filename="${mesh}/radome.stl"/></geometry><material name="white"/></visual>
    <collision><origin xyz="-0.10 0 0.265" rpy="0 ${PI/2} 0"/>
      <geometry><cylinder radius="0.170" length="0.60"/></geometry></collision>
    <xacro:box_inertia m="2.0" x="0.63" y="0.35" z="0.35"/>
  </link>

  <!-- trunnion truss (grey), tilts with the assembly -->
  <joint name="rod_joint" type="fixed"><parent link="gun_link"/><child link="rod_link"/>
    <origin xyz="0 0 0"/></joint>
  <link name="rod_link">
    <visual><geometry><mesh filename="${mesh}/rod.stl"/></geometry><material name="mgrey"/></visual>
    <collision><geometry><box size="0.17 0.325 0.235"/></geometry></collision>
    <xacro:box_inertia m="1.0" x="0.17" y="0.325" z="0.235"/>
  </link>

  <!-- ===================== CAMERA (EO box + lens, looks +X) =====================
       광학중심과 레이저는 gun_link 중심선(좌우 0)에 둔다. 브래킷 메시는 옆에 있지만
       센서 자체는 포신 바로 위에 정렬되어야 한다. camera_link 가 gun_link 기준
       좌우 +0.05 이므로 그 아래 오프셋을 -0.05 로 두어 합을 0 으로 맞춘다.

       왜 (2026-09-12 실측). smash_fcs.yaml 의 scope_to_muzzle_m 은 [0.45, 0.0, -0.066]
       으로 "조준경이 총열 바로 위에 정렬되어 있다(좌우 0)"를 전제한다. 그런데 이전
       구성은 광학중심을 gun_link 기준 좌우 +0.21 m 에 두어 그 전제를 깨고 있었다.
       가상 탄환은 카메라에서 유도한 총구에서 출발하는데(좌우 +0.21) 발사 방향은
       포신 보어사이트(pan 0 이면 좌우 성분 0)라, 좌우 0 에 있는 표적에는 도달할 수
       없다. 그 결과 좌우로 정확히 0.21 m 씩 빗나갔다.

         빗나감 벡터 평균 (world m)   10.8 m: (-0.181, +0.210, +0.048)
                                      35.3 m: (+0.530, +0.210, +0.294)
         Y 성분이 거리와 무관하게 +0.210 (표준편차 2~7 mm) = 이 좌우 오프셋과 같다.

       보정에 필요한 pan 각이 10.8 m 에서 31 px, 35 m 에서 9.5 px 로 둘 다 READY 임계
       35 px 안이라, 정렬이 "완료"된 채로 계속 빗나가는 조용한 실패였다.
       이 좌우 오프셋을 바꾸면 smash_fcs.yaml 의 gun_to_camera_optical_m 도 반드시
       함께 맞출 것. -->
  <joint name="camera_joint" type="fixed"><parent link="gun_link"/><child link="camera_link"/>
    <origin xyz="-0.07 0.05 0.15"/></joint>
  <link name="camera_link">
    <visual><geometry><mesh filename="${mesh}/camera.stl"/></geometry><material name="mgrey"/></visual>
    <collision><origin xyz="0.12 0.16 0.10"/><geometry><box size="0.218 0.075 0.075"/></geometry></collision>
    <inertial><origin xyz="0.12 0.16 0.10"/><mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
  </link>
  <joint name="camera_optical_joint" type="fixed"><parent link="camera_link"/><child link="camera_link_optical"/>
    <origin xyz="0.229 -0.05 0.10" rpy="0 0 0"/></joint>
  <link name="camera_link_optical"/>

  <!-- 센서 갱신 주기 30 Hz (카메라·레이저 공통).
       ※ 15 Hz 로 낮추는 안을 실측했으나 효과가 없어 되돌렸다(2026-09-12).
         i5-7400 4코어 / GTX 1050 Ti / WSL2 에서 2회 반복 측정:
           30 Hz 설정 -> 카메라 평균 9.9 Hz, FCS 처리율 평균 5.0 Hz
           15 Hz 설정 -> 카메라 평균 6.6 Hz, FCS 처리율 평균 5.1 Hz
         화면에 보이는 FCS 처리율은 그대로인데 카메라 주기만 떨어졌다. 병목이
         렌더링 주기가 아니라 CPU 코어 수(4개, HT 없음)이기 때문으로 보인다.
         같은 이유로 .wslconfig 로 코어를 늘리는 방법도 불가능하다(호스트가 4코어).
         측정으로 확인된 유일한 대안은 카메라 해상도를 320 으로 낮추는 것이며
         (FCS 처리율 약 3배), 대신 탐지 정확도와 READY 판정 기준이 함께 나빠진다.
         자세한 내용은 docs/sessions/session_work_summary_2026-09-12.md 참고. -->
  <gazebo reference="camera_link">
    <sensor name="turret_camera" type="camera">
      <pose>0.229 -0.05 0.10 0 0 0</pose>
      <always_on>1</always_on><update_rate>30</update_rate><visualize>true</visualize>
      <topic>/turret_camera/image_raw</topic><gz_frame_id>camera_link_optical</gz_frame_id>
      <camera><horizontal_fov>0.4</horizontal_fov>
        <image><width>640</width><height>640</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>500.0</far></clip></camera>
    </sensor>

    <!-- ===== SMASH FCS: 동축 광각 레이저 거리측정기 =====
         카메라 광학중심과 동일한 위치(0.229 -0.05 0.10)에 동축으로 놓인 LiDAR 다.

         왜 단일 보어사이트 빔이 아니라 원뿔형 다중 빔인가:
           카메라 광학중심과 포구는 gun_link 기준 (0.572, -0.21, -0.292) m 만큼
           떨어져 있고, 이 중 보어사이트에 수직인 성분이 약 0.359 m 다. 포탑이
           탄도해에 맞춰 지향하면 카메라 시선과 포신 지향선 사이에 시차가 생기며,
           그 크기는 35 m 교전에서 약 15.6 mrad(0.90도) 다(오프라인 검증 A3 항목).
           반면 35 m 의 소형 드론은 화면에서 약 21픽셀(13.4 mrad)에 불과하다.
           즉 포신이 정확히 조준된 순간, 표적은 카메라 주점에서 벗어나 있으므로
           주점에 고정된 단일 빔은 표적을 맞히지 못하고 배경(하늘)을 읽는다.
           실제로 오프라인 검증에서 단일 빔 구성은 전 프레임에서 무효였다.

         해결: 예상 시차 + 리드각 + 추적오차를 모두 덮는 +-0.04 rad(+-2.29도)
         원뿔로 넓히고, 원뿔 안의 최근접 유효 반사(first return)를 표적 거리로 쓴다.
         실제 펄스식 레이저 거리측정기의 first-return 논리와 동일한 방식이다.
         원뿔은 카메라 화각(+-0.2 rad) 안에 완전히 들어가므로, 빔이 맞힌 물체는
         반드시 화면에도 보인다. 오독을 막기 위해 바운딩박스 기하 추정치와의
         교차검증 게이트를 소프트웨어(range_estimator.py)에서 한 번 더 건다.

         33 x 33 = 1089 빔, 빔 간격 2.5 mrad.

         ★ 미해결: 이 레이저는 약 15 m 를 넘으면 반사가 전혀 돌아오지 않는다
           (2026-09-12 실측). 원인 미규명이며 근거를 아래에 남긴다. 그 거리 밖에서는
           거리추정이 전부 바운딩박스로 떨어지고, bbox sigma 는 35 m 에서 9.2 m 나
           되므로(HUD 실측 "RNG 34.50m +-9.23 [BOX]") 사거리 방향 산포가 그대로
           명중률을 깎는다. 35 m 명중률을 올리려면 여기부터 풀어야 한다.

           거리별 실측 (조준을 맞춰 STATE READY 인 상태에서 점군을 직접 관찰):
             10.8 m : 유효 반사  42 빔 / 1089   -> 레이저 채택, 최근접 10.48 m
             14.8 m : 유효 반사 156 빔 / 4225   -> 레이저 채택, 최근접 14.69 m
             19.1 m : 유효 반사   0 빔          -> bbox 로 낙하
             25.5 m : 유효 반사   0 빔
             35.3 m : 유효 반사   0 빔 (640/640 스캔 전부)

           기각한 원인 (재조사 금지):
             - 빔 밀도: 65x65(간격 1.25 mrad)로 올려도 35 m 에서 그대로 0 이었다.
               19 m 에서 표적 세로 각크기는 10.6 mrad 로 8빔에 걸쳐야 한다.
             - 점군 전달/지연: 21 Hz 로 정상 수신되고 staleness(0.2초) 초과 0 회.
             - <range><max>: 태그는 확실히 반영된다(12 m 로 낮추니 14.8 m 표적이
               0 이 되었다). 그런데 500 m 로도 50 m 로도 35 m 는 0 이었다 — 근/원
               평면 비율에 따른 깊이 정밀도 문제도 아니다.
             - 원뿔 밖으로 벗어남: 14.8 m 에서 반사는 센서축 기준 방위 +1.2~+15.0,
               앙각 -15.0~-0.0 mrad 에 찍혔다. 원뿔 한계 +-40 mrad 안이고, 이
               각오차는 거리가 멀수록 오히려 줄어든다.

           빔 수를 늘리는 것은 해법이 아니므로 33 x 33 을 유지한다. 65x65 의 비용은
           FCS 9.6 fps 대 10 fps 로 크지 않았으나, 문제를 풀지 못하는 변경을 남길
           이유가 없다. 참고로 빔 간격은 다음과 같다.
             samples  간격        35 m 에서 세로(9.2cm) 빔 수
                33    2.50 mrad     1.0
                65    1.25 mrad     2.1

         gpu_lidar 는 <topic> 으로 LaserScan(가운데 행)을,
         <topic>/points 로 PointCloudPacked(전체 격자)를 발행한다. FCS 노드는
         2차원 정보가 필요하므로 후자를 구독한다.

         빈 링크에 센서를 달면 gz-sim 이 고정관절을 병합하며 센서를 누락시키는
         경우가 있어, 관성이 정의된 camera_link 에 직접 부착했다. -->
    <sensor name="turret_boresight_laser" type="gpu_lidar">
      <pose>0.229 -0.05 0.10 0 0 0</pose>
      <always_on>1</always_on><update_rate>30</update_rate><visualize>false</visualize>
      <topic>/turret_camera/boresight_range</topic><gz_frame_id>camera_link_optical</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>33</samples><resolution>1</resolution>
            <min_angle>-0.04</min_angle><max_angle>0.04</max_angle>
          </horizontal>
          <vertical>
            <samples>33</samples><resolution>1</resolution>
            <min_angle>-0.04</min_angle><max_angle>0.04</max_angle>
          </vertical>
        </scan>
        <range><min>1.0</min><max>500.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.02</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ===================== Gazebo colours ===================== -->
  <gazebo reference="base_link"><visual><material><ambient>0.80 0.72 0.52 1</ambient><diffuse>0.82 0.74 0.54 1</diffuse></material></visual></gazebo>
  <gazebo reference="turret_link"><visual><material><ambient>0.75 0.75 0.77 1</ambient><diffuse>0.75 0.75 0.77 1</diffuse></material></visual></gazebo>
  <gazebo reference="gun_link"><gravity>false</gravity><visual><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material></visual></gazebo>
  <gazebo reference="radome_link"><gravity>false</gravity><visual><material><ambient>0.90 0.90 0.90 1</ambient><diffuse>0.95 0.95 0.94 1</diffuse></material></visual></gazebo>
  <gazebo reference="rod_link"><gravity>false</gravity><visual><material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual></gazebo>
  <gazebo reference="camera_link"><gravity>false</gravity><visual><material><ambient>0.50 0.50 0.52 1</ambient><diffuse>0.50 0.50 0.52 1</diffuse></material></visual></gazebo>

  <!-- ===================== ros2_control ===================== -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      <param name="position_proportional_gain">100.0</param>
    </hardware>
    <joint name="turret_pan_joint">
      <command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="turret_tilt_joint">
      <command_interface name="position">
        <param name="min">${0.0*PI/180.0}</param><param name="max">${85.0*PI/180.0}</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find ciws_turret)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
