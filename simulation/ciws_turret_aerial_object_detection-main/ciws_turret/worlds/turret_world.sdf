<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="turret_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <!-- Presentation palette: cool fill light, warm sun, matte ground.
           Lighting changes affect recorded pixels; do not mix image benchmarks
           from this scene with earlier recordings without noting the change. -->
      <ambient>0.48 0.51 0.56 1</ambient>
      <background>0.57 0.68 0.80 1</background>
      <sky></sky>
      <!-- 그림자 끔. 주의: 4코어 WSL2 + GTX 1050 Ti 환경에서 측정했을 때 속도 향상은
           확인되지 않았다(측정 편차가 효과보다 컸다). GPU 셰이딩이 아니라 CPU 경합이
           병목이기 때문으로 보인다. 렌더링 부하를 줄이는 것 자체는 무해하므로 꺼 둔다.
           참고: <sky> 제거도 함께 측정했으나 역시 향상이 없어 그대로 두었다. -->
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.92 0.88 0.81 1</diffuse>
      <specular>0.16 0.16 0.16 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.32 0.34 0.31 1</ambient>
            <diffuse>0.43 0.45 0.40 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
            <pbr>
              <metal>
                <metalness>0.0</metalness>
                <roughness>0.95</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
