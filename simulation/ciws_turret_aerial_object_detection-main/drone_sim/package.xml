<?xml version="1.0"?>
<package format="3">
  <name>drone_sim</name>
  <version>0.1.0</version>
  <description>SMASH FCS simulation: target drone, FCS node and turret driver for the CIWS turret.</description>
  <maintainer email="ajay@example.com">Ajay</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <!-- SMASH FCS 통합 노드(smash_fcs_node.py) 추가 의존성 -->
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export><build_type>ament_python</build_type></export>
</package>
