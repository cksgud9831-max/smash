<?xml version="1.0"?>
<sdf version="1.9">
  <model name="bird">
    <static>false</static>
    <link name="body">
      <gravity>false</gravity>
      <kinematic>true</kinematic>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.005</ixx><iyy>0.005</iyy><izz>0.005</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><mesh><uri>package://drone_sim/meshes/bird.stl</uri></mesh></geometry>
        <material>
          <ambient>0.08 0.08 0.09 1</ambient>
          <diffuse>0.12 0.12 0.13 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry><box><size>0.35 0.6 0.34</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
